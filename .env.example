# Copy to .env for local development (never commit .env). On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Everything is optional locally:
# without Razorpay keys you get a fake payment step, without Supabase orders and accounts go to .data/.

# Login sessions: the secret that signs the JWT in the session cookie. Required on Vercel; 32+ random characters,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Changing it signs everyone out.
JWT_SECRET=

# Razorpay - Dashboard -> Account & Settings -> API Keys (use rzp_test_... keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay - Dashboard -> Webhooks: URL https://<your-site>/api/razorpay-webhook/
# events payment.captured, order.paid, payment.failed; paste the secret you chose here
RAZORPAY_WEBHOOK_SECRET=

# Supabase - Project Settings -> API Keys: the project URL and a SECRET key (sb_secret_..., not sb_publishable_...)
# Run supabase/schema.sql once in the SQL Editor first (and again after updates - it's safe to repeat).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=order-photos

# Test orders: only from team test accounts (users.is_tester, set in the database - see supabase/schema.sql).
# TEST_PHONES is no longer used: test orders follow the logged-in account, not the phone number typed at checkout.
