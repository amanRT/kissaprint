# Copy to .env for local development (never commit .env). On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Everything is optional locally:
# without Razorpay keys you get a fake payment step, without Supabase orders go to .data/.

# Razorpay - Dashboard -> Account & Settings -> API Keys (use rzp_test_... keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay - Dashboard -> Webhooks: URL https://<your-site>/api/razorpay-webhook/
# events payment.captured, order.paid, payment.failed; paste the secret you chose here
RAZORPAY_WEBHOOK_SECRET=

# Supabase - Project Settings -> API Keys: the project URL and a SECRET key (sb_secret_..., not sb_publishable_...)
# Run backend/schema.sql once in the SQL Editor first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=order-photos

# Admin dashboard (/admin/). Locally defaults to "admin"; on Vercel it must be set (12+ characters, random).
ADMIN_PASSWORD=

# Team test numbers, comma-separated (e.g. 98xxxxxxxx,97xxxxxxxx). Orders placed with these mobile numbers
# skip payment and are labelled "Test" in the admin. Keep them in .env / Vercel only - the repo is public.
TEST_PHONES=
# Optional extra secret mixed into admin session cookies
# SESSION_SECRET=
