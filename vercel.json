{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh tools/vercel-build.sh",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{design/**,dist/**,qa/**,tests/**,tools/**,node_modules/**,.buildenv/**,src/static/**,src/templates/**,src/css/**,src/js/**}"
    }
  },
  "rewrites": [{ "source": "/api/:route*", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(checkout|order)/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
